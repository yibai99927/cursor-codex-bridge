# 示例。真正给 Codex 用的 MCP 段是本仓库 .codex/config.toml，
# 由 `node scripts/setup-project.mjs` 生成。禁止写入 ~/.codex。
# skill 正文在仓库 `.agents/skills/cursor-worker/`（Codex 会扫描该目录）。

[mcp_servers.cursor_worker]
command = "/ABS/PATH/TO/node"
args = ["/ABS/PATH/TO/cursor-codex-bridge/server.mjs"]
startup_timeout_sec = 20
tool_timeout_sec = 360
enabled = true

[mcp_servers.cursor_worker.env]
AGENT_BIN = "/ABS/PATH/TO/cursor-agent"
AGY_BIN = "/ABS/PATH/TO/agy"
CURSOR_WORKER_HOME = "/ABS/PATH/TO/cursor-codex-bridge/.codex/cursor-worker"
CURSOR_WORKER_ROOTS = "/ABS/PATH/TO/your/dev:/ABS/PATH/TO/your/Documents"
CURSOR_WORKER_MAX_RUNNING = "4"
CURSOR_WORKER_WAIT_MAX = "300"
CURSOR_WORKER_REQUIRE_SESSION = "1"
CURSOR_WORKER_DEFAULT_BACKEND = "cursor"
CURSOR_WORKER_DEFAULT_MODEL = "cursor-grok-4.6-xhigh-fast"
CURSOR_WORKER_CURSOR_TRANSPORT = "acp"

[features]
hooks = true

[[skills.config]]
enabled = true
path = "/ABS/PATH/TO/cursor-codex-bridge/.agents/skills/cursor-worker"
